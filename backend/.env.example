PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=change-this-before-use

# Optional Gemini Assistant settings (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional sample data on empty tables/menu collections; leave unset by default
# SEED_DEFAULT_BUSINESS_DATA=true

# Optional server mode; omit for local development
# NODE_ENV=production
